# ============================================================
#  QuantDesk for IBKR — 环境变量样例
#  复制为 backend/.env 或 backend/runtime/.env 后按需修改
# ============================================================

# ---------- 服务 ----------
QD_HOST=127.0.0.1
QD_PORT=8787
QD_OPEN_BROWSER=1
QD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787

# ---------- 认证 ----------
QD_TOKEN_TTL_MIN=720
QD_LOGIN_MAX_ATTEMPTS=8
QD_LOGIN_LOCKOUT_SEC=300

# ---------- 实盘交易（第一道锁）----------
# 默认关闭。即使打开，仍需在「实盘交易」页完成运行时解锁，且每笔订单还要通过风控护栏。
# ⚠️ 开启前请确认你完全理解资金风险。
QD_ALLOW_LIVE_TRADING=false

# ---------- IBKR ----------
QD_IBKR_HOST=127.0.0.1
QD_IBKR_CLIENT_ID=17
QD_IBKR_PAPER_TWS=7497
QD_IBKR_LIVE_TWS=7496
QD_IBKR_PAPER_GW=4002
QD_IBKR_LIVE_GW=4001

# ---------- 行情数据 ----------
QD_DATA_TIMEOUT=20
QD_CACHE_TTL=900

# ---------- AI 分析师（可选）----------
# 留空则使用内置本地量化引擎（纯计算，无需外部服务）。
# 填写任意 OpenAI 兼容接口即可升级为 LLM 深度解读。
QD_AI_BASE_URL=
QD_AI_API_KEY=
QD_AI_MODEL=gpt-4o-mini
